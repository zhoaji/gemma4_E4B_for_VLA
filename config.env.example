# Required. Obtain this after accepting the Gemma terms on Hugging Face.
HF_TOKEN=replace-with-your-huggingface-token

# The E4B model supports text, image, and audio input.
MODEL_ID=google/gemma-4-E4B-it-qat-w4a16-ct

# Fallback runtime for 16GB Orin systems: official GGUF E4B checkpoint.
LLAMA_MODEL_ID=ggml-org/gemma-4-E4B-it-GGUF:Q4_0
LLAMA_MODEL_FILE=gemma-4-E4B-it-Q4_0.gguf
LLAMA_MODEL_PATH=/models/gemma-4-E4B-it-Q4_0.gguf
LLAMA_VISION_FILE=mmproj-gemma-4-E4B-it-Q8_0.gguf
LLAMA_VISION_PATH=/models/mmproj-gemma-4-E4B-it-Q8_0.gguf
LLAMA_IMAGE=gemma4-llama-cuda126:d7a2074
LLAMA_PORT=8080
LLAMA_CTX_SIZE=4096
LLAMA_PARALLEL=1
LLAMA_GPU_LAYERS=99

# Only localhost is exposed by default. Change only after adding authentication
# and network controls in a reverse proxy.
HOST=127.0.0.1
PORT=8000
