[Unit]
Description=Gemma4 persistent shared CUDA Whisper ASR
Requires=gemma4-asr.socket
After=gemma4-asr.socket

[Service]
Type=simple
User=nvidia
Group=nvidia
WorkingDirectory=/home/nvidia/Desktop/gemma4_E4B
Environment=ASR_LANGUAGE=auto
Environment=ASR_BACKEND=cuda
ExecStart=/home/nvidia/anaconda3/bin/python3 /home/nvidia/Desktop/gemma4_E4B/app/brain/asr/server.py --socket-activation
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
