[Unit]
Description=Gemma4 on-demand Jetson system monitor
Requires=gemma4-system-monitor.socket
After=gemma4-system-monitor.socket

[Service]
Type=simple
User=nvidia
Group=nvidia
WorkingDirectory=/home/nvidia/Desktop/gemma4_E4B
ExecStart=/usr/bin/python3 /home/nvidia/Desktop/gemma4_E4B/app/brain/monitor/server.py --socket-activation --idle-seconds 90
Restart=no
TimeoutStopSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
